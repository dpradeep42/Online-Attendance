<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional. Web.config already points at SQL Server with Integrated Security and
  stores no password. You do not need this file for that setup.

  To use SQL authentication instead, copy this file to ConnectionStrings.secrets.config
  (same folder, gitignored), replace YOUR_SQL_USER and YOUR_SQL_PASSWORD, and change
  Web.config so the section is loaded from that file:

    <connectionStrings configSource="ConnectionStrings.secrets.config" />

  configSource replaces the whole section, so every name the app uses must be in the file.
  Do not commit ConnectionStrings.secrets.config.
-->
<connectionStrings>
  <add name="AttendanceEntities" connectionString="metadata=res://*/Models.Attendance.csdl|res://*/Models.Attendance.ssdl|res://*/Models.Attendance.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=Attendance;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  <add name="AttendanceEntities1" connectionString="metadata=res://*/Models.Model1.csdl|res://*/Models.Model1.ssdl|res://*/Models.Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=Attendance;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  <add name="AttendanceEntities2" connectionString="metadata=res://*/Models.Attendance.csdl|res://*/Models.Attendance.ssdl|res://*/Models.Attendance.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=Attendance;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;multipleactiveresultsets=True;application name=EntityFramework&quot;" providerName="System.Data.EntityClient" />
</connectionStrings>
