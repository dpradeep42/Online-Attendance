<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to AppSettings.secrets.config (same folder, gitignored) and
  replace the placeholders. Web.config loads it through appSettings file="AppSettings.secrets.config".
  A missing secrets file is ignored.

  Environment variables override these values. The app setting name works as the
  variable name, and so does the SMTP_* alias:

    SmtpUser / SMTP_USER
    SmtpPassword / SMTP_PASSWORD
    SmtpHost / SMTP_HOST
    SmtpPort / SMTP_PORT
    SmtpEnableSsl / SMTP_ENABLE_SSL

  Gmail: use an app password when 2-step verification is on. Host smtp.gmail.com,
  port 587, SSL true matches the previous mailer defaults.
-->
<appSettings>
  <add key="SmtpUser" value="YOUR_SMTP_USER" />
  <add key="SmtpPassword" value="YOUR_SMTP_PASSWORD" />
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpEnableSsl" value="true" />
</appSettings>
